# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
EVENT_HASH_CHAIN=false

# Infrastructure
POSTGRES_PORT=5432
REDIS_PORT=6379

DATABASE_URL=postgresql+psycopg://workflow:workflow@127.0.0.1:5432/workflow_engine
REDIS_URL=redis://localhost:6379/0

# Backups
BACKUP_ENABLED=true
BACKUP_STORAGE_DIR=backups
BACKUP_DEPLOYMENT_MODE=docker
BACKUP_DOCKER_CONTAINER=workflow_engine_postgres
BACKUP_POSTGRES_USER=workflow
BACKUP_ALLOW_RESTORE=true
BACKUP_RETENTION_COUNT=20

# CORS (comma-separated origins when overriding via env)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
