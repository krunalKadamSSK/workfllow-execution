# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
EVENT_HASH_CHAIN=false

# Infrastructure
POSTGRES_PORT=5432
REDIS_PORT=6379

DATABASE_URL=postgresql+psycopg://workflow:workflow@127.0.0.1:5432/workflow_engine
REDIS_URL=redis://localhost:6379/0

# Backups
BACKUP_ENABLED=true
BACKUP_STORAGE_DIR=backups
BACKUP_DEPLOYMENT_MODE=docker
BACKUP_OS=auto
BACKUP_DOCKER_CONTAINER=workflow_engine_postgres
BACKUP_DOCKER_CLI=
BACKUP_POSTGRES_USER=workflow
BACKUP_TOOL_PATH=
BACKUP_ALLOW_RESTORE=true
BACKUP_RETENTION_COUNT=20
# Phase 5: HTTP /backups off (Costing Engine uses Backup Ops). Set true to re-enable one release.
LEGACY_HTTP_BACKUPS_ENABLED=false

# CORS (JSON list or comma-separated via env parser)
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# AccessCore REST — set ENABLED=true for production / FE SSO cutover
# Use Admin UI managed key named "workflow-engine" (not AUTHORIZE_API_KEY).
ACCESSCORE_ENABLED=true
ACCESSCORE_URL=http://localhost:8081
ACCESSCORE_API_KEY=
ACCESSCORE_APPLICATION_ID=
ACCESSCORE_TIMEOUT_SECONDS=5.0
